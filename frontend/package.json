{
  "name": "virtual-ai-assistant-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3000",
    "dev:local": "pnpm msw:init && vite --port 3000 --mode localhost",
    "dev:test": "vite --port 3000 --mode test",
    "build": "tsc -b && vite build",
    "build:local": "pnpm msw:init && tsc -b && vite build --mode localhost",
    "build:dev": "tsc -b && vite build --mode development",
    "build:test": "tsc -b && vite build --mode test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "msw:init": "msw init",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "preview": "vite preview --port 3000",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "jose": "^6.0.11",
    "live2d-renderer-lite": "^0.3.2",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "^1.3.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@faker-js/faker": "^9.9.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/eslint-plugin": "^1.3.4",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-testing-library": "^7.5.3",
    "globals": "^16.3.0",
    "msw": "^2.10.2",
    "husky": "^9.1.7",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.1"
  },
  "browserslist": [
    "> 0.2%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "lint-staged": {
    "**/*": [
      "pnpm prettier:fix",
      "pnpm lint",
      "pnpm lint:fix",
      "git add ."
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
